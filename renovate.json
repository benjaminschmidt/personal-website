{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "kubernetes": {
    "managerFilePatterns": [
      "postgres.yaml"
    ]
  },
  "packageRules": [
    {
      "description": "Do not delay updates from the private Forgejo registry",
      "matchRegistryUrls": [
        "https://forgejo.fuzzyhome.net/**"
      ],
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Automerge uv patch updates",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "uv"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge trusted workflow actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "https://forgejo.fuzzyhome.net/phaib/simple-semantic-release"
      ],
      "automerge": true
    }
  ]
}
